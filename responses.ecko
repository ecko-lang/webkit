# webkit/responses - response builders and static file serving.

import std.http
import std.fs
import std.web
import "./util.ecko"
import "./markup.ecko"

# The lowercased file extension of a path, without the dot ("" if none).
fn ext_of(path) {
    parts = split(string(path), ".")
    if len(parts) < 2 { "" } else { lower(last(parts)) }
}

## content_type(path) -> a MIME type for the file's extension.
##
## Covers the web's common types and falls back to
## `application/octet-stream`, which browsers download rather than render.
export fn content_type(path) {
    types = {
        html: "text/html; charset=utf-8",
        htm: "text/html; charset=utf-8",
        css: "text/css; charset=utf-8",
        js: "text/javascript; charset=utf-8",
        mjs: "text/javascript; charset=utf-8",
        json: "application/json",
        xml: "application/xml",
        txt: "text/plain; charset=utf-8",
        md: "text/markdown; charset=utf-8",
        svg: "image/svg+xml",
        png: "image/png",
        jpg: "image/jpeg",
        jpeg: "image/jpeg",
        gif: "image/gif",
        webp: "image/webp",
        ico: "image/x-icon",
        woff: "font/woff",
        woff2: "font/woff2",
        wasm: "application/wasm",
        pdf: "application/pdf",
    }
    util.get_or(types, ext_of(path), "application/octet-stream")
}

## file(path, opts?) -> a response serving `path`, or a 404 if it is missing.
##
## The file is read on every call, so edits show up without a restart; that also
## means it is not free. `opts.cache` sets cache-control. For a whole directory
## use `static`, which is traversal-safe.
export fn file(path, opts = empty_map()) {
    unless fs.exists(path) { return http.response(404, "not found") }
    mut h = { "content-type": content_type(path) }
    c = get(opts, "cache")
    unless is_null(c) { h = insert(h, "cache-control", c) }
    http.response(200, fs.read_bytes(path), h)
}

## cache(resp, value) -> `resp` with a cache-control header.
export fn cache(resp, value) = util.with_header(resp, "cache-control", value)

## redirect(url, status?) -> a redirect response, 302 by default.
##
## Use 301 or 308 only when the move is permanent - browsers cache those hard
## enough that a mistake outlives the fix.
export fn redirect(url, status = 302) {
    { status: status, headers: { location: url }, body: "" }
}

## abort(status, body?) -> raises an error the app's error layer turns into a page.
##
## This is how a handler gives up mid-request: `abort(404)` from three calls deep
## reaches the registered 404 handler without every caller checking a return.
##
## example:
##   post = find(id) ; if post == null { abort(404) }
export fn abort(status, body = "") {
    error({ kind: "http", status: status, message: body })
}

## html(body, opts?) -> an HTML response. `opts.cache` sets cache-control.
##
## `body` must be markup from `render` or `raw`, never a plain string. The
## refusal is the point. Every route to the wire runs through a value that was
## either escaped or explicitly vouched for, so forgetting cannot put unescaped
## text on the page.
export fn html(body, opts = empty_map()) {
    unless markup.is_safe(body) {
        error(
            "webkit.html: expected markup from render() or raw(), got " +
                type_of(body) +
                " - build the page with render() so its values are escaped",
        )
    }
    r = http.html(body.html)
    c = get(opts, "cache")
    if is_null(c) { r } else { cache(r, c) }
}

## json(value, opts?) -> a JSON response. `opts.cache` sets cache-control.
export fn json(value, opts = empty_map()) {
    r = http.json(value)
    c = get(opts, "cache")
    if is_null(c) { r } else { cache(r, c) }
}

## text(s, opts?) -> a plain-text response. `opts.cache` sets cache-control.
export fn text(s, opts = empty_map()) {
    r = http.text(s)
    c = get(opts, "cache")
    if is_null(c) { r } else { cache(r, c) }
}

## static(prefix, dir) -> a route serving `dir` under `prefix`.
##
## Delegates to the native `web.static`, which resolves paths safely: `..` in a
## request cannot escape `dir`. Add caching with the `cache_control`
## middleware.
export fn static(prefix, dir) = web.static(prefix, dir)
