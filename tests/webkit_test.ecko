# Offline tests (ecko test): the pure web-app helpers - HTML escaping,
# auto-escaping templates, signed cookies, cookie building/parsing, and the
# CORS / security middleware. No network, no server.
import std.test
import "../main.ecko"

test.case("escape covers the five HTML-significant characters", fn() {
    test.eq(
        main.escape("<a href='x' title=\"y\">A & B</a>"),
        "&lt;a href=&#39;x&#39; title=&quot;y&quot;&gt;A &amp; B&lt;/a&gt;",
    )
})

test.case("sign then unsign round-trips the value", fn() {
    signed = main.sign("user=42", "s3cret")
    test.eq(main.unsign(signed, "s3cret"), "user=42")
})

test.case("unsign rejects a tampered value", fn() {
    signed = main.sign("user=42", "s3cret")
    tampered = replace(signed, "42", "99")
    test.eq(main.unsign(tampered, "s3cret"), null)
})

test.case("unsign rejects a wrong secret", fn() {
    signed = main.sign("user=42", "s3cret")
    test.eq(main.unsign(signed, "other"), null)
})

test.case("cookie builds a Set-Cookie with the security flags", fn() {
    c = main.cookie(
        "sid",
        "abc",
        { http_only: true, secure: true, same_site: "Lax", max_age: 3600, path: "/" },
    )
    test.eq(c, "sid=abc; Path=/; Max-Age=3600; HttpOnly; Secure; SameSite=Lax")
})

test.case("parse_cookies reads a Cookie header into a map", fn() {
    m = main.parse_cookies("sid=abc; theme=dark")
    test.eq(get(m, "sid"), "abc")
    test.eq(get(m, "theme"), "dark")
})

test.case("cors middleware adds the allow-origin header", fn() {
    mw = main.cors({ origin: "*" })
    # a fake downstream returning a bare response map
    next = fn(req) ({ status: 200, headers: empty_map(), body: "ok" })
    resp = mw({ method: "GET", headers: empty_map() }, next)
    test.eq(get(resp.headers, "access-control-allow-origin"), "*")
})

test.case("security_headers middleware sets hardening headers", fn() {
    mw = main.security_headers()
    next = fn(req) ({ status: 200, headers: empty_map(), body: "ok" })
    resp = mw({ method: "GET", headers: empty_map() }, next)
    test.eq(get(resp.headers, "x-content-type-options"), "nosniff")
    test.eq(get(resp.headers, "x-frame-options"), "DENY")
})
