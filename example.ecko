# webkit offline demo: templating + signed cookies + middleware, no server.
#
#   ecko example.ecko

import std.web
import "./main.ecko"

SECRET = "demo-secret-change-me"

# 1. Native templates + explicit escaping (webkit.e on untrusted data).
template page(title, note) = """<h1>{title}</h1><p>{note}</p>"""
rendered = page("Welcome", main.e("<script>alert(1)</script>"))
print("rendered: " + rendered)

# 2. Signed cookies round-trip; tampering is rejected.
signed = main.sign("user=42", SECRET)
print("signed:   " + signed)
print("unsign:   " + string(main.unsign(signed, SECRET)))
print("tampered: " + string(main.unsign(replace(signed, "42", "99"), SECRET)))

# 3. Middleware composed through the router (called directly, offline).
app = web.router(
    [web.get("/", fn(req) ({ status: 200, headers: empty_map(), body: "home" }))],
    [main.security_headers(), main.cors({ origin: "*" })],
)
resp = app({ method: "GET", path: "/", headers: empty_map(), params: empty_map() })
print("CORS:     " + get(resp.headers, "access-control-allow-origin"))
print("nosniff:  " + get(resp.headers, "x-content-type-options"))
