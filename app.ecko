# webkit/app - app assembly, blueprints, and error handling.

import std.web
import "./util.ecko"
import "./middleware.ecko"
import "./csrf.ecko"

# A plain fallback error response when no custom handler is registered.
fn default_error_page(status) {
    label = if status == 404 {
        "Not Found"
    } else if status == 500 {
        "Internal Server Error"
    } else {
        "Error"
    }
    {
        status: status,
        headers: { "content-type": "text/plain; charset=utf-8" },
        body: string(status) + " " + label,
    }
}

# Map a caught error to a response: an http error (from abort) uses its status;
# anything else is a bug -> 500. Uses the errors map ({ "<status>": handler }).
#
# Every error handler is called as `handler(req, err)`. `err` is the caught
# error, or null when the status came from the router finding no route.
fn handle_error(errors, req, e) {
    status = if get(e, "kind") == "http" { get(e, "status") } else { 500 }
    handler = get(errors, string(status))
    if is_null(handler) { default_error_page(status) } else { handler(req, e) }
}

# compose_mw(handler, mw) -> handler wrapped by the middleware list, outermost
# first. Uses reduce over the reversed list so each layer captures the next by
# value (no mutable-loop closure trap).
fn compose_mw(handler, mw) = reduce(reverse(mw), fn(acc, m) fn(req) m(req, acc), handler)

## blueprint(prefix, routes, mw?) -> `routes` with `prefix` on each path.
##
## Middleware in `mw` wraps only these routes, which is how a section of the site
## gets, say, authentication without the rest paying for it. Pass the result
## straight into an app's `routes` and it splices in.
export fn blueprint(prefix, routes, mw = []) {
    mut out = []
    for r in routes {
        mut base = insert(r, "path", string(prefix) + string(get(r, "path")))
        h = get(r, "handler")
        if not is_null(h) and len(mw) > 0 { base = insert(base, "handler", compose_mw(h, mw)) }
        out = push(out, base)
    }
    out
}

## app(spec) -> a request handler for `http.serve`.
##
## `spec` is `{ routes, middleware, errors, security, cors, csrf }`. Middleware
## runs outermost-first in the order given, after `security`, `cors` and `csrf`
## if those are set. `errors` maps a status as text to a handler, so
## `{ "404": page }`.
##
## `csrf` is a secret, and giving one installs CSRF protection over every
## state-changing route. Forms then need `csrf.field(req)` in them, and a form
## without it is refused. Leaving `csrf` out leaves those routes unprotected,
## which is almost never what you want for anything with a session.
##
## Every error handler is called as `handler(req, err)`. `err` is null when the
## router simply found no route, so one 404 handler serves both that case and
## an explicit `abort(404)`.
##
## example:
##   handler = app({ routes: [...], security: true, errors: { "404": not_found } })
##   http.serve(8080, handler)
export fn app(spec) {
    errors = util.get_or(spec, "errors", empty_map())
    mut mw = []
    if get(spec, "security") == true { mw = push(mw, middleware.security_headers()) }
    cors_opts = get(spec, "cors")
    unless is_null(cors_opts) { mw = push(mw, middleware.cors(cors_opts)) }
    csrf_secret = get(spec, "csrf")
    unless is_null(csrf_secret) { mw = push(mw, csrf.protect(csrf_secret)) }
    for m in util.get_or(spec, "middleware", []) {
        mw = push(mw, m)
    }
    # Flatten one level so a blueprint (a list of routes) splices in.
    mut flat = []
    for r in util.get_or(spec, "routes", []) {
        if type_of(r) == "list" {
            for br in r {
                flat = push(flat, br)
            }
        } else { flat = push(flat, r) }
    }
    router = web.router(flat, mw)
    fn(req) {
        result = try { router(req) } catch (e) { return handle_error(errors, req, e) }
        if get(result, "status") == 404 {
            h = get(errors, "404")
            # `null` for the error: a route simply not matching is not a thrown
            # error. It is still passed, so one handler works whether the 404
            # came from the router or from abort(404) - the two used to call
            # handlers with different arity, and a handler written for one
            # crashed on the other.
            if is_null(h) { result } else { h(req, null) }
        } else { result }
    }
}
